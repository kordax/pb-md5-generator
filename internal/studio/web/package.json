{
  "name": "pb-docs-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "check": "node build.mjs --check && node --check assets/app.mjs && node --check assets/core.mjs && node --check assets/storage.mjs && node --check assets/navigation.mjs",
    "test": "node --test test/*.test.mjs",
    "security": "npm audit --audit-level=moderate"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15"
  },
  "devDependencies": { "esbuild": "0.28.2", "linkedom": "0.18.14" }
}
